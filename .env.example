# Coin shop — Solana payments
# Copy to `.env.local` and fill in the treasury wallet to accept real SOL.
#
# Receives the SOL: any base58 wallet address (Phantom / Solflare / Backpack).
# While this is empty the shop runs in DEMO mode and says so in the checkout.
VITE_SOLANA_TREASURY=

# RPC endpoint used to verify a transfer (defaults to the public cluster).
# VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Which cluster the shop talks to: mainnet-beta | devnet (default: devnet)
# VITE_SOLANA_NETWORK=mainnet-beta

# USD price of 1 SOL used to convert the pack price into a SOL amount.
# VITE_SOL_USD=150
